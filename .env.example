# CLIProxyAPI Antigravity Multi-Model Endpoint
CLIPROXY_BASE_URL="http://127.0.0.1:8317/v1"
CLIPROXY_API_KEY="your-cliproxy-key-if-required"

# Model Routing Configuration
MODEL_CHAIRMAN="gemini-4-argon-high"
MODEL_ANALYTICS="gemini-4-argon-high"
MODEL_SCRIPTWRITER="claude-sonnet-5-5-high"
MODEL_VISUAL_DIRECTOR="claude-opus-5-5-high"
MODEL_VISION_INGESTION="gemini-3.8-flash-high"

# Voice & TTS Configuration
ELEVENLABS_API_KEY="your-elevenlabs-api-key"
ELEVENLABS_VOICE_ID="your-voice-id"

# YouTube Data API v3 OAuth Configuration
YOUTUBE_CLIENT_SECRETS_FILE="/path/to/client_secrets.json"
YOUTUBE_OAUTH_TOKEN_FILE="/path/to/oauth_token.json"
YOUTUBE_CHANNEL_ID="your-youtube-channel-id"

# PostgreSQL Database (Supabase / Local)
POSTGRES_DB_HOST="127.0.0.1"
POSTGRES_DB_PORT="5432"
POSTGRES_DB_NAME="postgres"
POSTGRES_DB_USER="postgres"
POSTGRES_DB_PASSWORD="your-postgres-password"
POSTGRES_SCHEMA="ai_brain"

# Swarm Matrix SQLite
SWARM_DB_PATH="data/agents_chat.db"

# Chrome CDP Automation
CHROME_CDP_PORT="9222"
CHROME_CDP_HOST="127.0.0.1"

# Telegram Notifications
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_OWNER_CHAT_ID="your-chat-id"
