# DONIES VIRGIN — ENVIRONMENT CONFIGURATION
# Safe placeholders for independent credentials. Never put production secrets here.

# Model Proxy (CLIProxyAPI Antigravity on VPS or custom provider)
CLIPROXY_BASE_URL="http://127.0.0.1:8317/v1"
CLIPROXY_API_KEY="your-cliproxy-key-placeholder"

# ElevenLabs Voice Synthesis for Virgin Clone
ELEVENLABS_API_KEY="your-elevenlabs-key-placeholder"
ELEVENLABS_VOICE_ID="your-virgin-voice-id"

# YouTube Data API v3 OAuth for Virgin Channel
VIRGIN_YOUTUBE_CLIENT_SECRETS="config/virgin_client_secrets.json"
VIRGIN_YOUTUBE_OAUTH_TOKEN="config/virgin_oauth_token.json"
VIRGIN_YOUTUBE_CHANNEL_ID="UC_YOUR_NEW_CHANNEL_ID"

# PostgreSQL Database Connection
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT="5432"
POSTGRES_DB="postgres"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-postgres-password"
POSTGRES_SCHEMA="ai_brain"
TABLE_PREFIX="virgin_"

# Chrome CDP Automation Port (if using autonomous browser scraping)
CHROME_CDP_HOST="127.0.0.1"
CHROME_CDP_PORT="9222"

# Telegram Bot Alerts for Virgin Instance
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"
